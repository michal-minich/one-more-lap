{
    "name": "one-more-lap",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 43195 --strictPort",
        "preview": "vite preview --host 127.0.0.1 --port 43195 --strictPort",
        "build": "npm run typecheck && vite build && node scripts/build-html.mjs && node scripts/cache-build.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/*.test.ts",
        "lint": "eslint .",
        "check": "npm run typecheck && npm run lint && npm test"
    },
    "dependencies": {
        "@babylonjs/core": "9.35.0",
        "@dimforge/rapier3d-compat": "0.21.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "24.19.2",
        "eslint": "10.12.0",
        "eslint-plugin-sonarjs": "4.2.2",
        "eslint-plugin-unicorn": "78.0.0",
        "globals": "17.13.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "7.3.1"
    }
}
